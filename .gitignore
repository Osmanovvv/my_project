# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Секреты окружения — в git не попадают, шаблон лежит в .env.example
.env
.env.*
!.env.example
!.env.development.example
!.env.production.example
!.env.docker.example
!.env.staging.example

# Каталог данных: база SQLite с заявками и контентом плюс загруженные картинки.
# Это боевые данные и персональные контакты клиентов — в репозиторий они
# не попадают ни при каких условиях. Путь задаётся переменной DATA_DIR,
# по умолчанию `.data` рядом с проектом.
.data
.data-*
.tmp-test

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Отчёты Lighthouse и прочие временные файлы замеров — в репозиторий
# не попадают. Однажды уже попали: команда замера писала JSON в корень.
lighthouse*.json
lh-*.json
lh-*.txt
g-*.json
f-*.json

# Личные подтверждения согласия из переписки — не отправлять в Git.
private/portfolio-permission-evidence/

# Посторонние артефакты, к сайту не относятся: сборка презентации
# (.codex-build, presentation-output) и отчёты ручных проверок Playwright.
.codex-build/
presentation-output/
output/
.playwright-cli/
