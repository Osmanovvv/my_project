# Staging configuration. Copy to .env.docker on the staging host only.
# It is isolated from production and never registers the shared bot webhook.
APP_ENV=staging
DATA_DIR=/var/lib/itagent
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=ITagent_bot
TELEGRAM_OPERATOR_NOTIFICATIONS=false
TELEGRAM_OPERATOR_IDS=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_TEST_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
VITE_SITE_URL=https://staging.itagent.ru
TELEGRAM_MINIAPP_URL=https://staging.itagent.ru/miniapp
