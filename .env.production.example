# Шаблон production-конфигурации. На сервере хранится отдельно от проекта.
APP_ENV=production
DATA_DIR=/var/lib/itagent
TELEGRAM_DELIVERY_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=ITagent_bot
# После проверки личного чата оператора переключить в true.
TELEGRAM_OPERATOR_NOTIFICATIONS=false
TELEGRAM_OPERATOR_IDS=
TELEGRAM_OPERATOR_CHAT_ID=
# Test-очередь в production также ограничена этими private user ID.
TELEGRAM_TEST_USER_IDS=
# Секрет webhook: install.sh сгенерирует его сам, если оставить пустым.
TELEGRAM_WEBHOOK_SECRET=
# VITE_SITE_URL задаётся перед сборкой, например:
# VITE_SITE_URL=https://itagent.ru
# TELEGRAM_MINIAPP_URL=https://itagent.ru/miniapp
