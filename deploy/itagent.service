# Юнит systemd для боевого сервера.
#
# Установка — deploy/install.sh делает всё сам. Руками:
#   sudo cp deploy/itagent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now itagent
#   sudo journalctl -u itagent -f                     ← смотреть лог
#
# Проверить, что настройки подхватились: открыть сайт и найти в логе строки
# «[настройки] …». Если там «уведомления о заявках: ВЫКЛЮЧЕНЫ» — заявки
# сохраняются, но в Telegram не приходят.

[Unit]
Description=IT-Agent — сайт, бот и админка заявок
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Не root. Пользователя заводит install.sh:
#   useradd --system --home /srv/itagent --shell /usr/sbin/nologin itagent
User=itagent
Group=itagent

WorkingDirectory=/srv/itagent
ExecStart=/usr/bin/node /srv/itagent/.output/server/index.mjs

# ── Настройки ────────────────────────────────────────────────────────────
# Секреты — в /etc/itagent/env (его создаёт deploy/install.sh, права 640
# root:itagent). Не здесь: файлы юнитов читает любой пользователь системы,
# токен бота в них — утечка. Состав файла:
#   PORT=3000
#   DATA_DIR=/var/lib/itagent      ← заявки, кейсы, фотографии; вне каталога приложения
#   ADMIN_PASSWORD=…               ← читается только при первом запуске, потом хранится хешем
#   TELEGRAM_BOT_TOKEN=…           ← без них заявки сохраняются, но в чат не приходят
#   TELEGRAM_CHAT_ID=…
# После правки файла: systemctl restart itagent
EnvironmentFile=/etc/itagent/env

# VITE_SITE_URL здесь НЕ задают: адрес вшивается в бандл при сборке —
# это делает deploy/release.sh.

# Файлы базы и фотографий — без прав для «остальных»: каталог и так 750,
# но страховка от одного ошибочного chmod лишней не будет.
UMask=0027

# ── Устойчивость ─────────────────────────────────────────────────────────
Restart=always
RestartSec=3

# ── Ограничения прав ─────────────────────────────────────────────────────
# Процессу нужен только каталог данных; всё остальное — только на чтение.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/itagent

[Install]
WantedBy=multi-user.target
