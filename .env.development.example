# Локальная разработка. Скопируйте в .env.
# Боевые токены сюда не переносите.
APP_ENV=development
DATA_DIR=.data-development
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=ITagent_bot
TELEGRAM_OPERATOR_NOTIFICATIONS=false
TELEGRAM_OPERATOR_IDS=
TELEGRAM_OPERATOR_CHAT_ID=
# Только эти user ID могут получать test-очередь в development.
TELEGRAM_TEST_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
VITE_SITE_URL=http://localhost:3000
# Для запуска из Telegram нужен опубликованный HTTPS-адрес.
# TELEGRAM_MINIAPP_URL=https://itagent.ru/miniapp
