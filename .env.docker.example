# Local Docker runtime. Copy to .env.docker if you need extra settings.
# Real Telegram delivery stays disabled until a deliberate production setup.
APP_ENV=development
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=ITagent_bot
TELEGRAM_OPERATOR_NOTIFICATIONS=false
TELEGRAM_OPERATOR_IDS=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_TEST_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINIAPP_URL=http://localhost:3000/miniapp
