# Скопируйте файл в `.env` и подставьте значения. `.env` в git не попадает.
# В продакшене задайте те же переменные в настройках проекта — файла `.env` там нет.

# --- Доставка заявок с формы в Telegram (серверные, в браузер не попадают) ---
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_ID   — чат, куда падают заявки: личный ID или ID группы
#                      (у групп он отрицательный, например -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Адрес сайта (публичный, попадает в клиентский бандл) ---
# Используется для canonical, og:image, sitemap.xml и микроразметки.
# Без слэша на конце. Если не задан — берётся https://itagent.ru.
# Задавайте явно на стендах, отличных от боевого (превью, тест), иначе
# поисковики получат ссылки на боевой домен со страниц копии.
VITE_SITE_URL=https://itagent.ru
