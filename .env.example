# Скопируйте файл в `.env` для локальной разработки.
# Для production используйте .env.production.example и отдельный env-файл
# сервера. Секреты и данные этих окружений не должны пересекаться.

APP_ENV=development
DATA_DIR=.data-development
TELEGRAM_DELIVERY_ENABLED=false

# --- Доставка заявок с формы в Telegram (серверные, в браузер не попадают) ---
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_ID   — чат, куда падают заявки: личный ID или ID группы
#                      (у групп он отрицательный, например -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=ITagent_bot
# Публичный HTTPS-адрес Mini App; по умолчанию VITE_SITE_URL/miniapp.
TELEGRAM_MINIAPP_URL=
TELEGRAM_OPERATOR_NOTIFICATIONS=false

# Операторское меню в личном чате бота (серверная проверка, не клиентская).
# TELEGRAM_OPERATOR_IDS — список user ID через запятую.
# TELEGRAM_OPERATOR_CHAT_ID — подтверждённый личный chat ID оператора.
# TELEGRAM_TEST_USER_IDS — список тестовых user ID через запятую.
# В development исходящий worker разрешает только private chat этих IDs;
# пустой список полностью блокирует тестовую отправку.
TELEGRAM_OPERATOR_IDS=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_TEST_USER_IDS=

# Секрет входящего webhook Telegram. Не совпадает с токеном бота.
# В development оставьте пустым. Для staging задайте отдельный секрет.
TELEGRAM_WEBHOOK_SECRET=

# --- Адрес сайта (публичный, попадает в клиентский бандл) ---
# Используется для canonical, og:image, sitemap.xml и микроразметки.
# Без слэша на конце. В production задаётся перед сборкой.
VITE_SITE_URL=http://localhost:3000
